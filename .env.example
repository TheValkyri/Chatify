# Chatify Environment Variables
# Copy this file to `.env.local` and fill in your values.
# Variables prefixed with VITE_ are exposed to the browser.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Leave empty to run in demo mode (localStorage only, no backend).
#
# IMPORTANT: Because Vite bundles environment variables statically at build time,
# these variables MUST be present in the environment or .env file when building
# the app for production (e.g., during `npm run build` in CI or deploy steps).
# Setting them only as server-side runtime secrets (e.g. in Cloudflare dashboard)
# will NOT be picked up by the browser client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Optional: Custom API ───────────────────────────────────────────────────
# Override if you run a separate API server (e.g., Edge Functions).
# VITE_API_URL=http://localhost:3001/api
